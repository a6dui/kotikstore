# Токен вашего бота от @BotFather (ОБЯЗАТЕЛЬНО):
# Пример: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# URL опубликованного WebApp на GitHub Pages:
WEBAPP_URL=https://a6dui.github.io/kotikstore/

# Telegram ID владельца (Super Admin):
OWNER_TELEGRAM_ID=5495568165

# --- Платежные шлюзы (заполняются по мере подключения) ---
# 1. CryptoBot (получить токен в @CryptoBot -> Crypto Pay -> Create App)
CRYPTOBOT_TOKEN=

# 2. Bot 2328 (получить в ЛК bot 2328.io)
BOT_2328_SHOP_ID=
BOT_2328_SECRET_KEY=

# 3. Platega (СБП, Карты РФ - platega.com)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET_KEY=

# 4. Enot.io
ENOT_MERCHANT_ID=
ENOT_SECRET_KEY=
